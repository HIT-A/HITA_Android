# Normalize text files so a checkout on any platform yields the same bytes.
# Shell scripts and the Gradle wrapper must be LF: bash reports
# "syntax error near unexpected token `$'\r'" on a CRLF script, which breaks
# ./gradlew, project_health_check.sh and scripts/ci/*.sh on Windows checkouts.
* text=auto

*.sh            text eol=lf
gradlew         text eol=lf
gradlew.bat     text eol=crlf

*.kt            text eol=lf
*.kts           text eol=lf
*.java          text eol=lf
*.gradle        text eol=lf
*.properties    text eol=lf
*.xml           text eol=lf
*.json          text eol=lf
*.md            text eol=lf
*.py            text eol=lf
*.pro           text eol=lf

*.bat           text eol=crlf
*.cmd           text eol=crlf

# Binary assets: never translate bytes.
*.png           binary
*.webp          binary
*.jpg           binary
*.ttf           binary
*.woff2         binary
*.jar           binary
*.jks           binary
