<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Android 16+: allows this app to request promoted ongoing notifications. -->
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:name=".HApplication"
        android:allowBackup="true"
        android:fullBackupContent="@xml/analytics_backup_rules"
        android:dataExtractionRules="@xml/analytics_data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:enableOnBackInvokedCallback="true"
        android:requestLegacyExternalStorage="true"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="true">

        <receiver
            android:name=".data.work.CourseSelectionAlarmReceiver"
            android:exported="false" />
        <receiver
            android:name=".data.work.CourseSelectionBootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
        <receiver
            android:name=".feature.livecourse.receiver.LiveCourseReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="cn.limpu.hita.action.LIVE_COURSE_TRIGGER" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
            </intent-filter>
        </receiver>
        <service
            android:name=".data.work.CourseSelectionForegroundService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
        <service
            android:name=".feature.livecourse.guard.LiveCourseGuardService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="User-enabled live course guard that checks the on-device timetable each minute and maintains the user's ongoing course status notification." />
        </service>

        <receiver
            android:name=".ui.widgets.today.normal.TodayWidget"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.CONFIGURATION_CHANGED" />
                <action android:name="cn.limpu.hita.WIDGET_EVENT_CLICK" />
                <action android:name="cn.limpu.hita.WIDGET_EVENT_REFRESH" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/today_widget_info" />
        </receiver>
        <service
            android:name=".ui.widgets.today.ListWidgetService"
            android:permission="android.permission.BIND_REMOTEVIEWS" />

        <receiver
            android:name=".ui.widgets.today.slim.TodayWidgetSlim"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.CONFIGURATION_CHANGED" />
                <action android:name="cn.limpu.hita.WIDGET_EVENT_CLICK2" />
                <action android:name="cn.limpu.hita.WIDGET_EVENT_REFRESH" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/today_slim_widget_info" />
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <activity
            android:name=".ui.main.MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.HITA.SplashScreen"
            android:windowSoftInputMode="stateHidden|adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".ui.timetable.manager.TimetableManagerActivity" />
        <activity android:name=".ui.subject.SubjectActivity" />
        <activity android:name=".ui.myprofile.MyProfileActivity" />
        <activity android:name=".ui.timetable.detail.TimetableDetailActivity" />
        <activity android:name=".ui.timetable.friend.FriendTimetableActivity" android:exported="false" />
        <activity android:name=".ui.timetable.friend.FriendTimetableDetailActivity" android:exported="false" />
        <activity android:name=".ui.timetable.share.TimetableShareActivity" android:exported="false" />
        <activity
            android:name=".ui.ActivitySplash"
            android:exported="false"
            android:theme="@style/SplashTheme" />
        <activity android:name=".ui.teacher.ActivityTeacherOfficial" />
        <activity
            android:name=".ui.search.SearchActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustPan">
            <tools:validation testUrl="http://hita.store/search" />
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:host="hita.store"
                    android:pathPrefix="/search"
                    android:scheme="http" />
            </intent-filter>
        </activity>
        <activity android:name=".ui.eas.score.ScoreInquiryActivity" />
        <activity android:name=".ui.eas.catalog.ShenzhenCourseCatalogActivity" />
        <activity android:name=".ui.eas.catalog.ShenzhenCourseRecommendationActivity" />
        <activity android:name=".ui.eas.grade.ShenzhenGradeAnalysisActivity" />
        <activity android:name=".ui.eas.training.ShenzhenTrainingPlanActivity" />
        <activity
            android:name=".ui.eas.login.WebViewLoginActivity"
            android:theme="@style/Theme.HITA.WebViewLogin" />
        <activity
            android:name=".ui.notice.InfoPortalLoginActivity"
            android:theme="@style/Theme.HITA.WebViewLogin" />
        <activity android:name=".ui.eas.imp.ImportTimetableActivity" />
        <activity android:name=".ui.eas.classroom.EmptyClassroomActivity" />
        <activity android:name=".ui.profile.ProfileActivity" />
        <activity android:name=".ui.eas.exam.ExamActivity" />
        <activity android:name=".ui.about.ActivityAbout" />
        <activity android:name=".ui.notice.AppNoticesActivity" />
        <activity android:name=".ui.blog.BlogReaderActivity" />
        <activity android:name=".ui.links.UsefulLinksActivity" />
        <activity android:name=".ui.news.lecture.ActivityLecture" />
        <activity android:name=".ui.news.NewsDetailActivity" />
        <activity android:name=".ui.resource.InternalWebActivity" />
        <activity android:name=".ui.resource.UnifiedResourceSearchActivity" />
        <activity android:name=".ui.resource.CourseResourceSearchActivity" />
        <activity android:name=".ui.resource.CourseReadmeActivity" />
        <activity android:name=".ui.resource.CourseContributionActivity" />
        <activity android:name=".ui.resource.MarkdownViewerActivity" />
        <activity android:name=".ui.credit.CreditStatsActivity" />
    </application>

</manifest>
